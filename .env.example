# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3020

# ── Database (PostgreSQL – Neon in production) ─────────────────────────
# Local dev cluster started by `npm run db:local` listens on port 5544.
PRISMA_DATABASE_URL=postgresql://postgres@127.0.0.1:5544/chique_bags
PRISMA_DATABASE_URL_UNPOOLED=postgresql://postgres@127.0.0.1:5544/chique_bags

# ── Sessions (random strings, 32+ chars each) ──────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string-for-customers
ADMIN_SESSION_SECRET=change-me-to-another-long-random-string-for-admin

# ── Owner / admin account created by `npm run db:seed` ─────────────────
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD="ChangeMe#2026"
ADMIN_NAME=Priyanka Vora

# ── Email (SMTP). Without these, emails are printed to the server log ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Chique Bags <hello@example.com>"
# Where contact-form messages and new-order alerts are sent
OWNER_EMAIL=

# ── Razorpay (leave empty in development to use the built-in test payment) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp (digits only, with country code, e.g. 919876543210). Can also be set in Admin > Settings ──
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Cloudinary (admin photo uploads) ───────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Upstash Redis (optional, rate limiting across serverless instances) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
